# ── Conexión Supabase (Frontend) ──
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_PUBLISHABLE_O_ANON_KEY

# URL pública del logo subido a Supabase Storage (opcional)
VITE_CLUB_LOGO_URL=https://TU-PROYECTO.supabase.co/storage/v1/object/public/assets/logo.png

# ── Datos de Cobro por Transferencia ──
# Alias bancario oficial para transferencias
VITE_CLUB_ALIAS=ANDES.TALLERES.FUTSAL

# Teléfono de WhatsApp para recibir comprobantes (código país + área + número sin espacios ni guiones)
VITE_WHATSAPP_PHONE=5492610000000

# ── Configuración SMTP Nodemailer (Gmail con Contraseña de Aplicación) ──
# Servidor SMTP (por defecto smtp.gmail.com si no se especifica)
SMTP_HOST=smtp.gmail.com

# Puerto SMTP (por defecto 465)
SMTP_PORT=465

# Seguridad SSL/TLS: true para puerto 465, false para 587 con STARTTLS
SMTP_SECURE=true

# Correo de Gmail desde donde se envían las entradas
SMTP_USER=tu-correo@gmail.com

# Contraseña de aplicación de 16 caracteres de Google (NO tu contraseña personal de Gmail)
# Generala en: https://myaccount.google.com/apppasswords
SMTP_PASS=abcd efgh ijkl mnop

# Remitente visible en el correo (Opcional, por defecto usa SMTP_USER)
MAIL_FROM=Andes Talleres <tu-correo@gmail.com>
